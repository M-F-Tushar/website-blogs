APP_ENV=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
CONTACT_RATE_LIMIT_SECRET=replace-with-a-long-random-string
RESEND_API_KEY=your-resend-api-key
CONTACT_NOTIFICATION_FROM_EMAIL=notifications@example.com
CONTACT_NOTIFICATION_EMAIL=owner@example.com

# Optional overrides:
# Explicitly disable Turnstile verification (testing hosts only; local stage skips it automatically).
# CONTACT_BOT_PROTECTION=off
# Trusted client-IP header for contact rate limiting. Defaults to x-vercel-forwarded-for;
# set this when hosting behind a different reverse proxy, or per-IP limits are inactive.
# TRUSTED_IP_HEADER=x-forwarded-for
